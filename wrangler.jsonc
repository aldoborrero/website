// Static site on Workers Static Assets. The Worker and its custom domain are
// managed by tofu (terraform/cloudflare.tf); wrangler only uploads and deploys
// versions. Keep `name` in sync with local.worker_name there.
{
  "name": "aldoborrero-website",
  "compatibility_date": "2026-11-16",
  "assets": {
    // Output of `nix build .#site -o result-site` (justfile `build`).
    "directory": "./result-site",
    "not_found_handling": "404-page",
  },
  // Domains are owned by tofu, so wrangler must not touch routes.
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
}
