# shellcheck shell=bash
# Copy to .envrc.local (gitignored) for per-machine overrides.
# Normally these come from secrets/secrets.yaml (see WEBSITE_LOAD_SECRETS below).

## OpenTofu / Cloudflare provider and wrangler
# URL: https://dash.cloudflare.com/profile/api-tokens
#   Account token with: Workers Scripts:Edit, Zone:Read, Workers Routes:Edit (zone),
#   DNS:Edit (zone, needed by Workers custom domains)
export CLOUDFLARE_API_TOKEN=TODO
export CLOUDFLARE_ACCOUNT_ID=TODO

## OpenTofu state backend (Cloudflare R2, bucket aldoborrero-tfstate)
# URL: https://dash.cloudflare.com/?to=/:account/r2/api-tokens
#   R2 API token with Object Read & Write on the state bucket
export AWS_ACCESS_KEY_ID=TODO
export AWS_SECRET_ACCESS_KEY=TODO
export AWS_ENDPOINT_URL_S3="https://${CLOUDFLARE_ACCOUNT_ID}.r2.cloudflarestorage.com"

# Decrypt secrets/secrets.yaml into the environment on every direnv load
# (needed for `just tf-*` / `just deploy`; prompts for the YubiKey).
export WEBSITE_LOAD_SECRETS=1
