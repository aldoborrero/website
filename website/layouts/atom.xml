{{- /* Atom 1.0 with full text, beside every RSS feed at atom.xml. */ -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome }}{{ $pages = partial "stream-pages.html" . }}{{ else if eq .Kind "term" }}{{ $pages = .Pages }}{{ end -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 }}{{ $pages = first $limit $pages }}{{ end -}}
{{- $title := site.Title }}{{ if not .IsHome }}{{ $title = printf "%s: %s" site.Title (cond (eq .Kind "term") (printf "#%s" .LinkTitle) .Title) }}{{ end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.Language.Locale }}">
  <title>{{ $title }}</title>
  <subtitle>{{ .Description | default site.Params.description }}</subtitle>
  {{- with .OutputFormats.Get "atom" }}
  <link href="{{ .Permalink }}" rel="self" type="application/atom+xml"/>
  {{- end }}
  <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
  <id>{{ .Permalink }}</id>
  <updated>{{ with $pages }}{{ (index . 0).Lastmod.Format "2006-01-02T15:04:05Z07:00" }}{{ else }}{{ now.Format "2006-01-02T15:04:05Z07:00" }}{{ end }}</updated>
  <author>
    <name>{{ site.Params.author }}</name>
    <uri>{{ site.Home.Permalink }}</uri>
  </author>
  {{- range $pages }}
  <entry>
    <title>{{ (partial "kind.html" .).title }}</title>
    <link href="{{ .Permalink }}" rel="alternate" type="text/html"/>
    {{- with .Params.link }}
    <link href="{{ . }}" rel="related"/>
    {{- end }}
    <id>{{ .Permalink }}</id>
    <published>{{ .Date.Format "2006-01-02T15:04:05Z07:00" }}</published>
    <updated>{{ .Lastmod.Format "2006-01-02T15:04:05Z07:00" }}</updated>
    {{- range .GetTerms "tags" }}
    <category term="{{ .LinkTitle }}"/>
    {{- end }}
    <content type="html">{{ partial "feed-body.html" . | transform.XMLEscape | safeHTML }}</content>
  </entry>
  {{- end }}
</feed>
