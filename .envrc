#!/usr/bin/env bash

# Load the Nix flake
use flake

# Load local environment variables if .envrc.local exists
source_env_if_exists .envrc.local

# Export the sops-encrypted secrets (tofu provider/backend credentials).
# Opt in with `export WEBSITE_LOAD_SECRETS=1` in .envrc.local, since decrypting
# requires the YubiKey on every reload.
if [[ ${WEBSITE_LOAD_SECRETS:-0} == 1 ]]; then
  watch_file secrets/secrets.yaml
  eval "$(sops -d --output-type dotenv secrets/secrets.yaml | direnv dotenv bash /dev/stdin)"
fi
